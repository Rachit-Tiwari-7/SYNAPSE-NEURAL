# =========================================================
# Synapse-OS WhatsApp Service Configuration (Gemini Powered)
# =========================================================

# 1. Google Gemini API (Primary Clinical & Multimodal Intelligence Engine)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2

# 2. Meta WhatsApp Cloud API (Graph API v20.0)
# Configure from Meta Developers Portal -> WhatsApp -> API Setup
# If left empty, the service runs in SANDBOX_SIMULATION mode for seamless local testing
WHATSAPP_CLOUD_API_TOKEN=your_meta_permanent_or_temporary_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=synapse_secret_token_123
WHATSAPP_API_VERSION=v20.0

# 3. Server Configuration
HOST=0.0.0.0
PORT=8001
DEBUG=True
