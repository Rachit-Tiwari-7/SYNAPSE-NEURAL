# SynapseOS — Environment Configuration

# Meta Official WhatsApp Cloud API (Graph API) Settings (100% Free Sandbox - No Credit Card)
WHATSAPP_CLOUD_API_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="100000000000000"
WHATSAPP_BUSINESS_ACCOUNT_ID="100000000000000"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="synapse_secret_token_123"
