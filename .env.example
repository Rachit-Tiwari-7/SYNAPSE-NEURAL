OPENAI_API_KEY=""

# Production Medical Prescription OCR (OpenRouter Free Multimodal Vision Models)
OPENROUTER_PRIMARY_MODEL="google/gemma-4-31b-it:free"
OPENROUTER_SECONDARY_MODEL="google/gemma-4-26b-a4b-it:free"
OPENROUTER_TERTIARY_MODEL="nvidia/nemotron-nano-12b-v2-vl:free"
OPENROUTER_TIMEOUT_MS="45000"
MAX_PRESCRIPTION_IMAGE_MB="10"
MAX_IMAGE_DIMENSION="2048"
OCR_SECOND_PASS_ENABLED="false"

# FractureNet YOLOv8 Bone Fracture Detection (Hugging Face Space / Fast Remote Inference)
